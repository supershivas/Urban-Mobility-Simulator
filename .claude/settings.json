{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/sync-game-system.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(vendor/**)",
      "Read(data/original/**)",
      "Read(data/processed/*.geojson)",
      "Read(node_modules/**)",
      "Read(captures/**)"
    ]
  }
}
